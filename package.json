{
  "name": "chat",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "setup": "sh scripts/fetch-pocketbase.sh",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "sh scripts/pb-types.sh && tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "lint:sinks": "sh scripts/check-no-html-sinks.sh",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "screenshots": "node --no-warnings scripts/screenshots.ts",
    "schema:snapshot": "vitest run --project integration -u tests/integration/schema.snapshot.test.ts",
    "check": "npm run typecheck && npm run lint && npm run lint:sinks && npm test && npm run test:int && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.2",
    "esbuild": "0.28.2",
    "eventsource": "5.1.2",
    "happy-dom": "20.14.5",
    "playwright-core": "1.63.0",
    "pocketbase": "0.28.1",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
